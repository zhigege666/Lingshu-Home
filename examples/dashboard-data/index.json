{
  "format": "lingshu-home-dashboard-data-examples",
  "indexVersion": 1,
  "contractVersion": 1,
  "exampleCollectedAt": "2024-01-15T08:00:00Z",
  "description": "Machine-readable handoff index for existing component contracts. This index is not a Home API payload, JSON Schema validator, source registration or dashboard import file.",
  "automaticallyLoaded": false,
  "api": {
    "createSource": {
      "method": "POST",
      "path": "/api/v1/spaces/{spaceId}/sources"
    },
    "pushSnapshot": {
      "method": "PUT",
      "path": "/api/v1/sources/{id}/snapshot"
    },
    "readSnapshot": {
      "method": "GET",
      "path": "/api/v1/sources/{id}/snapshot"
    },
    "queuePoll": {
      "method": "POST",
      "path": "/api/v1/sources/{id}/sync",
      "body": {}
    },
    "externalJSON": {
      "method": "GET",
      "responseObject": "The data property of a push example, without the envelope."
    }
  },
  "limits": {
    "maximumRawDataBytes": 1048576,
    "maximumNormalizedDataBytes": 1048576,
    "maximumSourcesPerSpace": 64,
    "maximumBindingsPerPage": 32,
    "maximumViewsPerPage": 32,
    "storage": "one-latest-snapshot-per-component-source",
    "unknownDataFields": "rejected"
  },
  "semantics": {
    "timestampFormat": {
      "envelope.sourceUpdatedAt": "RFC3339 or null",
      "calendarAndWeatherInstants": "UTC Unix seconds, not milliseconds"
    },
    "freshness": {
      "values": [
        "fresh",
        "stale",
        "disabled"
      ],
      "clock": "Home receivedAt plus source staleAfterSeconds; lastError also makes retained data stale.",
      "sourceUpdatedAtDoesNotDriveFreshness": true
    },
    "missingSnapshot": "Awaiting data; not a synthetic zero or empty successful result.",
    "sampleTime": "All examples are fixed at 2024-01-15T08:00:00Z. Calendar events and weather values are fictional; metrics/status are unknown. Never refresh their timestamp and present them as live.",
    "requiredFields": "Required fields must be present and non-null, except metric value explicitly allows null.",
    "fieldNotes": "These handoff notes are not an exhaustive validator. The Go normalizeComponentData implementation is authoritative."
  },
  "contracts": [
    {
      "schemaId": "metrics.summary",
      "schemaVersion": 1,
      "renderer": "builtin/metrics",
      "input": "metrics",
      "sourceCreate": {
        "name": "Example metrics handoff",
        "kind": "external-push",
        "schemaId": "metrics.summary",
        "schemaVersion": 1,
        "connection": {},
        "sync": {
          "mode": "push",
          "staleAfterSeconds": 300
        },
        "enabled": true
      },
      "requiredFields": [
        "metrics"
      ],
      "collection": {
        "field": "metrics",
        "maximumEntries": 32,
        "requiredEntryFields": [
          "id",
          "label",
          "value"
        ],
        "entryFields": [
          "id",
          "label",
          "value",
          "unit",
          "min",
          "max",
          "status"
        ],
        "uniqueKey": "id"
      },
      "fieldRules": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "label": {
          "nonBlank": true,
          "maximumUtf8Bytes": 100
        },
        "value": {
          "types": [
            "number",
            "null"
          ],
          "minimum": -1e+18,
          "maximum": 1e+18,
          "nullMeans": "unknown"
        },
        "unit": {
          "maximumUtf8Bytes": 30,
          "semantics": "Display label; upstream performs conversion."
        },
        "min": {
          "types": [
            "number",
            "null"
          ],
          "minimum": -1e+18,
          "maximum": 1e+18
        },
        "max": {
          "types": [
            "number",
            "null"
          ],
          "minimum": -1e+18,
          "maximum": 1e+18
        },
        "status": {
          "values": [
            "ok",
            "warning",
            "critical",
            "unknown"
          ],
          "omissionAllowed": true
        }
      },
      "crossFieldRules": [
        "IDs are unique within the snapshot.",
        "When both numeric min and max are supplied, max must be greater than min.",
        "value:null is normalized to status:unknown.",
        "Missing value is invalid; zero is a measured value."
      ],
      "examples": [
        {
          "file": "metrics.resources.push.json",
          "semantics": "explicit-unknown",
          "suggestedSlots": [
            "service-operations/resources"
          ]
        },
        {
          "file": "metrics.overview.push.json",
          "semantics": "explicit-unknown",
          "suggestedSlots": [
            "data-summary/overview"
          ]
        },
        {
          "file": "metrics.secondary.push.json",
          "semantics": "explicit-unknown",
          "suggestedSlots": [
            "data-summary/secondary"
          ]
        }
      ]
    },
