    {
      "schemaId": "calendar.events",
      "schemaVersion": 1,
      "renderer": "builtin/calendar",
      "input": "events",
      "sourceCreate": {
        "name": "Example calendar handoff",
        "kind": "external-push",
        "schemaId": "calendar.events",
        "schemaVersion": 1,
        "connection": {},
        "sync": {
          "mode": "push",
          "staleAfterSeconds": 1800
        },
        "enabled": true
      },
      "requiredFields": [
        "timezone",
        "windowStart",
        "windowEnd",
        "events"
      ],
      "collection": {
        "field": "events",
        "maximumEntries": 500,
        "requiredEntryFields": [
          "id",
          "title",
          "startAt",
          "endAt",
          "allDay"
        ],
        "entryFields": [
          "id",
          "title",
          "startAt",
          "endAt",
          "allDay",
          "startDate",
          "endDate",
          "timezone",
          "location",
          "description",
          "url",
          "status"
        ],
        "uniqueKey": "id"
      },
      "fieldRules": {
        "timezone": {
          "semantics": "Explicit IANA timezone, not Local.",
          "maximumUtf8Bytes": 80
        },
        "windowStart": {
          "unit": "unix-seconds",
          "minimumExclusive": 0
        },
        "windowEnd": {
          "unit": "unix-seconds",
          "exclusive": true,
          "maximumLocalCalendarDaysFromWindowStart": 90
        },
        "events[].id": {
          "nonBlank": true,
          "maximumUtf8Bytes": 256
        },
        "events[].title": {
          "nonBlank": true,
          "maximumUtf8Bytes": 300
        },
        "events[].startAt": {
          "unit": "unix-seconds"
        },
        "events[].endAt": {
          "unit": "unix-seconds",
          "maximumDurationSeconds": 31622400
        },
        "events[].startDate": {
          "format": "YYYY-MM-DD",
          "requiredWhen": "allDay:true"
        },
        "events[].endDate": {
          "format": "YYYY-MM-DD",
          "exclusive": true,
          "requiredWhen": "allDay:true"
        },
        "events[].status": {
          "values": [
            "confirmed",
            "tentative",
            "cancelled"
          ],
          "default": "confirmed"
        },
        "events[].location": {
          "maximumUtf8Bytes": 500
        },
        "events[].description": {
          "maximumUtf8Bytes": 4000
        }
      },
      "crossFieldRules": [
        "Events must overlap the declared time window; its end is exclusive.",
        "All-day dates must match midnight startAt/endAt in event timezone, falling back to dataset timezone.",
        "Timed events must not contain startDate or endDate.",
        "The normalizer sorts events by startAt then id."
      ],
      "examples": [
        {
          "file": "calendar.events.push.json",
          "semantics": "synthetic-fixed-time",
          "suggestedSlots": [
            "personal-overview/calendar"
          ]
        },
        {
          "file": "calendar.empty.push.json",
          "semantics": "successful-empty-window",
          "suggestedSlots": [
            "personal-overview/calendar"
          ]
        }
      ]
    },
